# Copy to .env. Without keys the app runs in deterministic DEMO mode (synthetic corpus, no network).

# LLM (planning, claim extraction, synthesis) via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional cheaper/faster model for high-volume extraction (claims, numbers, entities). Defaults to OPENROUTER_MODEL.
# A good split: OPENROUTER_MODEL=openai/gpt-4o (synthesis) + OPENROUTER_FAST_MODEL=openai/gpt-4o-mini (extraction)
OPENROUTER_FAST_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Live web search (optional): https://tavily.com
TAVILY_API_KEY=

# Academic sources (OpenAlex, Crossref, arXiv) need no key. A contact email is recommended for polite API use.
CONTACT_EMAIL=
# Optional: Semantic Scholar works without a key (shared rate limit); a free key raises the limit.
SEMANTIC_SCHOLAR_API_KEY=

# Optional settings
APP_DB_PATH=data/research.db
HTTP_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=15
