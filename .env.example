# Copy to .env. Without keys the app runs in deterministic DEMO mode (synthetic corpus, no network).

# Explicitly allow a private local session without Google sign-in.
# Deployed apps must use APP_ENV=production and configure [auth] in Streamlit Secrets.
APP_ENV=local

# LLM (planning, claim extraction, synthesis) via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Live web search (optional): https://tavily.com
TAVILY_API_KEY=

# Academic sources (OpenAlex, Crossref, arXiv) need no key. A contact email is recommended for polite API use.
CONTACT_EMAIL=

# Optional settings
APP_DB_PATH=data/research.db
HTTP_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=15

# ---- Persistent, shared storage (optional). Without these, data is stored in a local SQLite file.
# Turso (hosted libSQL): turso db show <name> --url  /  turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Sign-in (optional). Configure Google login in .streamlit/secrets.toml under [auth] (see README).
# Comma-separated emails allowed to change app-wide settings (providers, models, cache).
ADMIN_EMAILS=

# Optional current model prices, USD per million tokens (0 = unknown, not free).
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0

# Optional LangSmith tracing. Master switch also controls automatic graph traces.
LANGSMITH_TRACING=false
APP_API_TRACING=true
LANGSMITH_PROJECT=deep-researcher-local
# Set endpoint to the region where your LangSmith workspace lives.
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_WORKSPACE_ID=your_workspace_id
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
